{
  "name": "gtm-opportunity-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, evidence-led GTM opportunity intelligence",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "corepack pnpm -r build",
    "dev": "corepack pnpm --parallel --filter @gtm/api --filter @gtm/worker --filter @gtm/web dev",
    "dev:api": "corepack pnpm --filter @gtm/api dev",
    "dev:worker": "corepack pnpm --filter @gtm/worker dev",
    "dev:web": "corepack pnpm --filter @gtm/web dev",
    "dev:mcp": "corepack pnpm --filter @gtm/mcp dev",
    "db:generate": "corepack pnpm --filter @gtm/db db:generate",
    "db:migrate": "corepack pnpm --filter @gtm/db db:migrate",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "corepack pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
