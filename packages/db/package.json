{
  "name": "@gtm/db",
  "version": "0.1.0",
  "type": "module",
  "exports": { ".": { "types": "./src/index.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@gtm/ai": "workspace:*",
    "@gtm/analytics": "workspace:*",
    "@gtm/crawler": "workspace:*",
    "@gtm/contacts": "workspace:*",
    "@gtm/operations": "workspace:*",
    "@gtm/research": "workspace:*",
    "@gtm/scoring": "workspace:*",
    "@gtm/shared": "workspace:*",
    "@gtm/signals": "workspace:*",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5"
  }
}
